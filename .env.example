# Application
NODE_ENV=development
APP_NAME=JERTINA
APP_URL=http://localhost:3000

# Public runtime values
NEXT_PUBLIC_APP_NAME=JERTINA
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jertina

# Authentication
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-thinking-mini

# Infrastructure
REDIS_URL=redis://localhost:6379
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
