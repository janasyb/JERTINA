{
  "name": "@jertina/api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API gateway for the JERTINA platform.",
  "license": "UNLICENSED",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "node src/runtime.mjs",
    "build": "pnpm --filter @jertina/database prisma:generate && node ../../scripts/build-service-runtime.mjs api",
    "start": "node src/runtime.mjs",
    "lint": "echo 'api lint checks are covered by workspace validation'",
    "test": "node src/test-runtime.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@jertina/database": "workspace:*"
  }
}
